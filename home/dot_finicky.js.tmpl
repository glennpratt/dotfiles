// https://github.com/johnste/finicky/wiki/Configuration-(v4)
{{- /*
  Registered overlays (.chezmoitemplates/overlay-dirs) contribute
  fragments/finicky/*.js, each a single JS array literal of handlers, inlined
  here ahead of the rules below. Read from the overlay checkouts, so no apply
  order is needed.
*/}}
{{- $fragments := list }}
{{- range includeTemplate "overlay-dirs" . | splitList "\n" | compact }}
{{-   $fragments = concat $fragments (glob (joinPath . "fragments/finicky/*.js")) }}
{{- end }}
export default {
  // No profile: let Chrome open in whatever window/profile was last active
  defaultBrowser: "Google Chrome",
  handlers: [
{{- range $fragments }}
    // {{ . | replace $.chezmoi.homeDir "~" }}
    ...(
      {{ include . | trim | replace "\n" "\n      " }}
    ),
{{- end }}
    {
      match: ["mail.google.com/*"],
      browser: {
        name: "Google Chrome",
        profile: "Glenn", // glennpratt@gmail.com
      },
    },
  ],
};
