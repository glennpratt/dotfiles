{{- /*
  Fully owned by chezmoi: VS Code UI edits are overwritten on apply, so make
  changes in .chezmoitemplates/vscode-settings.jsonc (or check `chezmoi diff`
  first and port anything worth keeping).

  Registered overlays (.chezmoitemplates/overlay-dirs) contribute
  fragments/vscode/*.json, read straight from their checkouts and deep-merged
  on top, so no apply order is needed.
*/ -}}
{{- $settings := include ".chezmoitemplates/vscode-settings.jsonc" | fromJsonc -}}
{{- range includeTemplate "overlay-dirs" . | splitList "\n" | compact -}}
{{-   range glob (joinPath . "fragments/vscode/*.json") -}}
{{-     $settings = mergeOverwrite $settings (include . | fromJsonc) -}}
{{-   end -}}
{{- end -}}
{{ $settings | toPrettyJson "    " }}
